# Public (safe for the browser). Project Settings > API in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Public site URL used in auth email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never prefix with NEXT_PUBLIC_. Needed later for Selar webhooks.
# SUPABASE_SERVICE_ROLE_KEY=
